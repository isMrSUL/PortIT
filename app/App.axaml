<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PortIT.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- PortIT palette (the same as AnimIT): deep blue-black panels, a blue -> cyan accent -->
    <Color x:Key="CBg">#0A0D13</Color>
    <Color x:Key="CSurface">#11151D</Color>
    <Color x:Key="CSurface2">#171C26</Color>
    <Color x:Key="CRaised">#1D2330</Color>
    <Color x:Key="CBorder">#252C3A</Color>
    <Color x:Key="CText">#E9EDF5</Color>
    <Color x:Key="CDim">#98A2B5</Color>
    <Color x:Key="CFaint">#646E82</Color>
    <Color x:Key="CAccent">#3B8CFF</Color>
    <Color x:Key="CAccentHi">#62B8FF</Color>
    <Color x:Key="CAccentSel">#13274A</Color>
    <Color x:Key="CCyan">#22C7E8</Color>
    <!-- the Fluent accent (checked toggles, focus) is ours too -->
    <Color x:Key="SystemAccentColor">#3B8CFF</Color>
    <Color x:Key="SystemAccentColorDark1">#2F78E0</Color>
    <Color x:Key="SystemAccentColorDark2">#2563BC</Color>
    <Color x:Key="SystemAccentColorDark3">#1C4C91</Color>
    <Color x:Key="SystemAccentColorLight1">#5FA2FF</Color>
    <Color x:Key="SystemAccentColorLight2">#7DB4FF</Color>
    <Color x:Key="SystemAccentColorLight3">#9CC6FF</Color>
    <SolidColorBrush x:Key="Bg" Color="{StaticResource CBg}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource CSurface}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource CSurface2}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource CRaised}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource CBorder}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource CText}" />
    <SolidColorBrush x:Key="Dim" Color="{StaticResource CDim}" />
    <SolidColorBrush x:Key="Faint" Color="{StaticResource CFaint}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource CAccent}" />
    <SolidColorBrush x:Key="AccentHi" Color="{StaticResource CAccentHi}" />
    <SolidColorBrush x:Key="AccentSel" Color="{StaticResource CAccentSel}" />
    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#3B8CFF" Offset="0" />
      <GradientStop Color="#22C7E8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradHi" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#5FA2FF" Offset="0" />
      <GradientStop Color="#45D6F2" Offset="1" />
    </LinearGradientBrush>
    <!-- Fluent overrides so stock controls match -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#0E121A" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#121722" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#121722" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource CBorder}" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#33405A" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource CAccent}" />
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#0E121A" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource CBorder}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource CSurface2}" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource CAccent}" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource CAccentHi}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource CCyan}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource CCyan}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource CAccentHi}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{StaticResource CAccentHi}" />
    <SolidColorBrush x:Key="SliderTrackFill" Color="#28303F" />
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource Bg}" />
      <Setter Property="FontFamily" Value="Inter, Segoe UI" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <!-- section headings: an accent bar + a plain bold title -->
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.bar">
      <Setter Property="Width" Value="3" />
      <Setter Property="Height" Value="14" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{StaticResource AccentGrad}" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.sub">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
    </Style>
    <Style Selector="TextBlock.faint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#9FB4D6" />
    </Style>
    <!-- panels and wells -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="BorderBrush" Value="#1A202B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Border.well">
      <Setter Property="Background" Value="#0D1118" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.box">
      <Setter Property="Background" Value="#0D1118" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.field">
      <Setter Property="Background" Value="#0D1118" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.bare">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="#14243F" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="Background" Value="#161C27" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,1" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="#14243F" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,1" />
    </Style>
    <!-- the floating transport over the stage -->
    <Style Selector="Border.transport">
      <Setter Property="Background" Value="#E6121722" />
      <Setter Property="BorderBrush" Value="#2A3346" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <!-- buttons: soft pills; the main action has the gradient -->
    <Style Selector="Button">
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#283043" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{StaticResource AccentGrad}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentGradHi}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.accent:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#16233A" />
      <Setter Property="Foreground" Value="#6E7C94" />
    </Style>
    <Style Selector="Button.round">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="ToggleButton.chip">
      <Setter Property="Padding" Value="11,4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentGrad}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <!-- tabs on the right panel -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <!-- list rows (moves, clips): a left strip lights up when chosen -->
    <Style Selector="ListBox.rows">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem Border.row">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="11,8" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:pointerover Border.row">
      <Setter Property="Background" Value="#1C2230" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected Border.row">
      <Setter Property="Background" Value="{StaticResource AccentSel}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentGrad}" />
    </Style>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Application.Styles>
</Application>
