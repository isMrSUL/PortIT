<Project Sdk="Microsoft.NET.Sdk">
  <!-- parity checks: the C# engine against the Python engine's results on the same files -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>portit-check</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EngineNet\PortIT.Engine.csproj" />
  </ItemGroup>
</Project>
