<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>PortIT</AssemblyName>
    <RootNamespace>PortIT</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <Version>1.3.3</Version>
    <ApplicationIcon>Assets/portit.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- the C# engine (EngineNet) and its parity checker against the old Python engine (EngineNet.Check) are projects of their own -->
    <Compile Remove="EngineNet\**;EngineNet.Check\**" />
    <None Remove="EngineNet\**;EngineNet.Check\**" />
    <AvaloniaResource Include="Assets/portit.ico;Assets/portit_256.png" />
    <!-- the engine is C# (EngineNet, in-process); beside PortIT.exe only the 2K26 archive reader's DLLs and the big-model
         DLL (the old Python engine in Engine\ stays in the source tree for comparing: PORTIT_PYTHON_ENGINE=1) -->
    <Content Include="Engine\cake\*.dll;Engine\bigmodel\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="EngineNet\PortIT.Engine.csproj" />
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
  </ItemGroup>
</Project>
